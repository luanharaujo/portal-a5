/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), screen-wake-lock=(), display-capture=(), usb=(), serial=(), bluetooth=(), hid=(), payment=(), publickey-credentials-get=(self), publickey-credentials-create=(self)
  Strict-Transport-Security: max-age=31536000
  X-Frame-Options: DENY

# the page itself is always revalidated; its scripts and styles carry a content version (deploy)
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
# loaded without a version by the tab pages (their CSP names these exact paths): revalidate each load
/_shell/tabs.js
  Cache-Control: no-cache
/_shell/tabs.css
  Cache-Control: no-cache
/locale/pt-BR.js
  Cache-Control: no-cache
# only ever loaded with ?v=<content hash> (scripts/build_assets.py): a new file gets a new URL,
# so the browser keeps these and asks nothing on the next opening
/app.js
  Cache-Control: public, max-age=31536000, immutable
/_shell/entry.js
  Cache-Control: public, max-age=31536000, immutable
/visual.css
  Cache-Control: public, max-age=31536000, immutable
/vendor/*
  Cache-Control: public, max-age=31536000, immutable
# drawings, icons and launch images: a day, then checked again
/art/*
  Cache-Control: public, max-age=86400
/splash/*
  Cache-Control: public, max-age=86400
/favicon.svg
  Cache-Control: public, max-age=86400
